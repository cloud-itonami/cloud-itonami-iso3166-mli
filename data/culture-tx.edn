#:culture{:id "mli.dish.fonde-monoo", :name "Fonde/monoo", :country "MLI", :kind :dish, :summary "A Malian millet porridge that is also commonly eaten in Senegal, part of a Malian food culture heavily based on cereal grains.", :url "https://en.wikipedia.org/wiki/Malian_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
